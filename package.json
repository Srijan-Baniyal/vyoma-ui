{
  "name": "vui",
  "version": "1.5.0",
  "private": false,
  "type": "module",
  "author": "Srijan Baniyal",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/GenerateSourceMap.js && node scripts/GenerateSitemap.js",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh $(node -p \"require('./package.json').version.replace(/\\d+$/, m => +m + 1)\")",
    "release:minor": "./scripts/release.sh $(node -p \"const v = require('./package.json').version.split('.'); v[1] = +v[1] + 1; v[2] = 0; v.join('.')\")",
    "release:major": "./scripts/release.sh $(node -p \"const v = require('./package.json').version.split('.'); v[0] = +v[0] + 1; v[1] = 0; v[2] = 0; v.join('.')\")\"",
    "version": "echo $(node -p \"require('./package.json').version\")"
  },
  "dependencies": {
    "@ncdai/react-wheel-picker": "^1.2.2",
    "@number-flow/react": "^0.6.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/fiber": "^9.6.0",
    "@tabler/icons-react": "^3.41.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "html-react-parser": "6.0.1",
    "lodash": "^4.18.1",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-syntax-highlighter": "16.1.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "three": "^0.182.0-"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@eslint/eslintrc": "3.3.5",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.182.0",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "ultracite": "7.6.1"
  }
}
